# ALI Cargo - pengaturan keamanan dan kecepatan
# Semua blok dibungkus IfModule supaya tidak error kalau modul tidak ada.

Options -Indexes

# URL bersih untuk halaman publik di folder utama (tanpa .php).
# Folder deprixa/ (admin) tidak disentuh. Halaman baru harus ditambahkan ke daftar ini.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # index.php -> /
  RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/index\.php[?\s]
  RewriteRule ^index\.php$ / [R=301,L]
  # alamat lama dengan .php -> alamat bersih (hanya GET, supaya form POST tidak terganggu)
  RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/(about-us|awards|contact-us|cookie-policy|faq|layanan|privacy-policy|refund-policy|rute-pengiriman|terms-and-conditions|tracking|ekspedisi-jakarta-[a-z0-9-]+)\.php[?\s]
  RewriteRule ^(about-us|awards|contact-us|cookie-policy|faq|layanan|privacy-policy|refund-policy|rute-pengiriman|terms-and-conditions|tracking|ekspedisi-jakarta-[a-z0-9-]+)\.php$ /$1 [R=301,L]
  # alamat bersih -> file .php
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(about-us|awards|contact-us|cookie-policy|faq|layanan|privacy-policy|refund-policy|rute-pengiriman|terms-and-conditions|tracking|ekspedisi-jakarta-[a-z0-9-]+)$ $1.php [L]
</IfModule>

# Blokir file yang tidak boleh dibuka dari browser (log, backup, database, pengaturan)
<FilesMatch "(\.(log|sql|bak|old|orig|swp|sqlite|ini|env|inc|md|lock)$|^\.|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Header keamanan
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

# Cache gambar, CSS, JS dan font di browser pengunjung
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
